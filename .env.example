ANTHROPIC_API_KEY=sk-ant-...
PORT=3000

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Service-role key: the LemonSqueezy webhook uses it to bypass RLS when writing
# subscriptions. Code reads SUPABASE_SERVICE_ROLE_KEY first, then SUPABASE_SERVICE_KEY.
# Set at least one — if neither is set, paid subscriptions will NOT activate.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# LemonSqueezy (payments)
LEMONSQUEEZY_API_KEY=...
LEMONSQUEEZY_STORE_ID=...
LEMONSQUEEZY_PRO_VARIANT_ID=...
LEMONSQUEEZY_UNLIMITED_VARIANT_ID=...
LEMONSQUEEZY_WEBHOOK_SECRET=...
